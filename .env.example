# Required for shared canonical data.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Required for SEC requests. Include a real app/contact string.
SEC_USER_AGENT=Abrams13F/1.0 contact@example.com

# Optional. Leave blank for local dev-auth; configure in production if using Supabase Auth.
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local defaults.
ENV=development
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000

# Optional and usually off on the current Neon tier.
# Enables the worker's scheduled Yahoo price backfill into the prices table.
ENABLE_PRICE_SYNC=0

# Optional. Refreshes compact fund_price_metrics from the price warehouse into Neon.
ENABLE_PRICE_METRICS_SYNC=0
PRICE_METRICS_REFRESH_LIMIT=25
PRICE_METRICS_REFRESH_HOURS=24

# Local price warehouse. This is bulk analytical storage, not app-state truth.
PRICE_WAREHOUSE_BACKEND=local
PRICE_WAREHOUSE_PATH=backend/data/price_warehouse

# R2/S3-compatible warehouse settings. Set PRICE_WAREHOUSE_BACKEND=s3 in production.
PRICE_WAREHOUSE_BUCKET=
PRICE_WAREHOUSE_ENDPOINT_URL=
PRICE_WAREHOUSE_ACCESS_KEY_ID=
PRICE_WAREHOUSE_SECRET_ACCESS_KEY=
PRICE_WAREHOUSE_PREFIX=abrams13f/price_warehouse
